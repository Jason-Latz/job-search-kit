<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobsearchkit.digest</string>
  <key>ProgramArguments</key>
  <array><string>__REPO__/bin/run-local.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <!-- launchd fires a missed calendar job once on wake, so a sleeping Mac delays the
       run rather than skipping it. A powered-off Mac still misses it. -->
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__REPO__/logs/run.log</string>
  <key>StandardErrorPath</key><string>__REPO__/logs/run.err</string>
  <key>WorkingDirectory</key><string>__REPO__</string>
</dict>
</plist>
